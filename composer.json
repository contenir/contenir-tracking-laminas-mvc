{
    "name": "contenir/tracking-laminas-mvc",
    "description": "Laminas MVC view helpers for contenir/tracking: tracking()->head() and tracking()->bodyStart() write a site's tags, Consent Mode first, with the page's CSP nonce.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "analytics",
        "tracking",
        "consent-mode",
        "laminas",
        "mvc"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-tracking-laminas-mvc/issues",
        "source": "https://github.com/contenir/contenir-tracking-laminas-mvc"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/tracking": "0.1.x-dev",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "laminas/laminas-view": "^2.30",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "phpunit/phpunit": "^11.5.42"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-tracking"
        }
    ],
    "autoload": {
        "psr-4": {
            "Contenir\\Tracking\\Laminas\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Tracking\\Laminas\\Mvc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "module": "Contenir\\Tracking\\Laminas\\Mvc",
            "config-provider": "Contenir\\Tracking\\Laminas\\Mvc\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
